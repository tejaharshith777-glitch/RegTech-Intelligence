# ─────────────────────────────────────────────────────────────
# RegTech Intelligence — API environment
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string.
# NOTE: the variable is MONGODB_URI, not MONGO_URI.
MONGODB_URI=

# JWT signing secret — use a long random string in production
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google Gemini API key (server-side only; never expose to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of browser origins allowed to call the API directly.
# The shipped Vercel frontend reaches the API through a same-origin rewrite,
# so this only matters if you host the frontend somewhere else.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5000

# Server-side administrator bootstrap. Any account registering with one of
# these emails is created as an administrator; every other account is a
# researcher. This is the ONLY way to become an admin without an existing
# admin promoting you. Comma-separated, case-insensitive.
ADMIN_EMAILS=

# Refuse to start when MongoDB is unreachable (recommended in production).
DISABLE_MEMORY_FALLBACK=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
